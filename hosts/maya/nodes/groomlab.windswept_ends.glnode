{
  "glnode": 1,
  "id": "groomlab.windswept_ends",
  "version": 1,
  "label": "Wind-swept Ends",
  "category": "deform",
  "description": "The ends of the strands swept one way, as by a steady wind, with a little flutter at the tips. Roots stay put.",
  "author": "GroomLab",
  "license": "Apache-2.0",
  "size": 20,
  "inputs": [{"name": "strands", "type": "Strands"}],
  "output": {"name": "out", "type": "Curves"},
  "params": [
    {"name": "angle", "target": "sweep.angle", "label": "Sweep", "default": 40.0, "min": 0, "softMax": 120,
     "unit": "angle", "mappable": true, "description": "Degrees the ends turn toward the wind"},
    {"name": "start", "target": "sweep.start", "label": "Starts at", "default": 0.5, "min": 0, "max": 1,
     "unit": "fraction", "description": "Where along the strands the sweep starts, 0 root to 1 tip"},
    {"name": "direction", "target": "sweep.direction", "label": "Wind direction", "default": [1, 0, 0],
     "description": "The way the wind blows (world space)"},
    {"name": "flutter", "target": "flutter.amplitude", "label": "Flutter", "default": 0.25, "min": 0, "softMax": 1,
     "unit": "length", "mappable": true, "description": "How far the tips flutter, in scene units"}
  ],
  "graph": {
    "version": 1,
    "nodes": [
      {"name": "in", "type": "Input", "params": {"name": "strands", "type": "Strands"}, "ui": {"x": 0, "y": 0}},
      {"name": "sweep", "type": "Bend", "ui": {"x": 240, "y": 0},
       "params": {"angle": 40.0, "start": 0.5, "end": 1.0, "along": "direction", "direction": [1, 0, 0],
                  "randomness": 0.35, "seed": 11}},
      {"name": "flutter", "type": "Noise", "ui": {"x": 480, "y": 0},
       "params": {"amplitude": 0.25, "frequency": 0.15, "space": "world", "profile": [[0, 0], [0.5, 0], [1, 1]], "seed": 13}}
    ],
    "connections": [
      {"from": "in", "to": "sweep", "input": "strands"},
      {"from": "sweep", "to": "flutter", "input": "strands"}
    ],
    "output": "flutter"
  }
}
