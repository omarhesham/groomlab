# Runs the SDK sample groom_to_obj and checks the OBJ it writes: one "l" per strand and one "v"
# per point, as many as it reports, and the last polyline ending on the last point.
#   cmake -DEXE=<groom_to_obj> -DOUT=<file.obj> [-DGROOM=<file.groom>] [-DSCALP=<mesh.obj>]
#         [-DFRAME=<frame>] [-DDENSITY=<0-1>] [-DSTRANDS=<expected count>] -P check_groom_to_obj.cmake
set(args)
if(GROOM)
    list(APPEND args --groom "${GROOM}")
endif()
if(SCALP)
    list(APPEND args --scalp "${SCALP}")
endif()
if(FRAME)
    list(APPEND args --frame "${FRAME}")
endif()
if(DENSITY)
    list(APPEND args --density "${DENSITY}")
endif()
file(REMOVE "${OUT}")
execute_process(COMMAND "${EXE}" ${args} "${OUT}" RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT rc EQUAL 0)
    message(FATAL_ERROR "groom_to_obj failed (${rc}):\n${out}${err}")
endif()
message(STATUS "${out}${err}")

if(NOT out MATCHES "([0-9]+) strands, ([0-9]+) points")
    message(FATAL_ERROR "groom_to_obj printed no counts: ${out}")
endif()
set(strands ${CMAKE_MATCH_1})
set(points ${CMAKE_MATCH_2})
if(STRANDS AND NOT strands EQUAL STRANDS)
    message(FATAL_ERROR "expected ${STRANDS} strands, got ${strands}")
endif()
if(strands EQUAL 0 OR points LESS strands)
    message(FATAL_ERROR "a groom of ${strands} strands and ${points} points")
endif()

file(STRINGS "${OUT}" vertices REGEX "^v ")
file(STRINGS "${OUT}" lines REGEX "^l ")
list(LENGTH vertices vertex_count)
list(LENGTH lines line_count)
if(NOT vertex_count EQUAL points OR NOT line_count EQUAL strands)
    message(FATAL_ERROR "the OBJ holds ${vertex_count} points and ${line_count} polylines, not ${points} and ${strands}")
endif()
list(GET lines -1 last)
if(NOT last MATCHES " ${points}$")
    message(FATAL_ERROR "the last polyline does not end on point ${points}: ${last}")
endif()
