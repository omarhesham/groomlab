{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://getgroomlab.com/schemas/ui.schema.json",
  "title": "GroomLab UI definitions",
  "description": "One schema for every file in engine/ui: each file holds one or more of the top-level keys (docs/UI_DEFINITIONS.md).",
  "type": "object",
  "required": ["version"],
  "additionalProperties": false,
  "properties": {
    "$schema": {"type": "string"},
    "version": {"const": 1},
    "actions": {
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/id"},
      "additionalProperties": {"$ref": "#/$defs/action"}
    },
    "menus": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/container"}
    },
    "palette": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tabs", "sections", "output", "texts"],
      "properties": {
        "tabs": {"type": "array", "items": {
          "type": "object", "additionalProperties": false, "required": ["id", "label"],
          "properties": {"id": {"type": "string"}, "label": {"type": "string"}, "tip": {"type": "string"},
                         "aliases": {"type": "array", "items": {"type": "string"}}}}},
        "header": {"type": "object", "additionalProperties": {
          "type": "object", "additionalProperties": false,
          "properties": {"tip": {"type": "string"}, "items": {"$ref": "#/$defs/entries"}}}},
        "empty": {"type": "object", "additionalProperties": false, "required": ["title", "items"],
                  "properties": {"title": {"type": "string"}, "items": {"$ref": "#/$defs/entries"}}},
        "sections": {"type": "array", "items": {
          "type": "object", "additionalProperties": false, "required": ["id", "label"],
          "properties": {"id": {"type": "string"}, "label": {"type": "string"}, "expanded": {"type": "boolean"}}}},
        "output": {"$ref": "#/$defs/entries"},
        "starter": {
          "type": "object", "additionalProperties": false, "required": ["steps"],
          "properties": {
            "title": {"type": "string"}, "dismissTip": {"type": "string"},
            "steps": {"type": "array", "items": {
              "type": "object", "additionalProperties": false, "required": ["id", "label", "tip"],
              "properties": {"id": {"type": "string"}, "label": {"type": "string"}, "tip": {"type": "string"}}}},
            "lookTypes": {"type": "array", "items": {"type": "string"}}}},
        "texts": {"type": "object", "additionalProperties": {"type": "string"}}
      }
    },
    "lists": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {"anyOf": [{"$ref": "#/$defs/container"}, {"type": "string"}]}
      }
    },
    "choices": {
      "type": "object",
      "additionalProperties": {
        "type": "object", "additionalProperties": false, "required": ["items"],
        "properties": {
          "label": {"type": "string"}, "tip": {"type": "string"},
          "default": {"type": ["string", "number"]},
          "items": {"type": "array", "minItems": 1, "items": {
            "type": "object", "additionalProperties": false, "required": ["value", "label"],
            "properties": {"value": {"type": ["string", "number"]}, "label": {"type": "string"}, "tip": {"type": "string"},
                           "convert": {"type": "string"}, "tag": {"type": "string"}}}}
        }
      }
    },
    "markingMenu": {
      "type": "object", "additionalProperties": false, "required": ["radial", "overflow", "tail"],
      "properties": {
        "radial": {"type": "array", "items": {
          "type": "object", "additionalProperties": false, "required": ["position", "tool"],
          "properties": {"position": {"enum": ["N", "NE", "E", "SE", "S", "SW", "W", "NW"]}, "tool": {"type": "string"}}}},
        "overflow": {"type": "object", "additionalProperties": false, "required": ["generator"],
                     "properties": {"generator": {"const": "brushCatalog"}, "exclude": {"type": "array", "items": {"type": "string"}}}},
        "tail": {"type": "array", "items": {"anyOf": [
          {"$ref": "#/$defs/id"},
          {"type": "object", "additionalProperties": false, "required": ["tool"], "properties": {"tool": {"type": "string"}}}]}}
      }
    },
    "graph": {
      "type": "object",
      "properties": {
        "categoryColors": {"type": "object", "additionalProperties": {"$ref": "#/$defs/color"}},
        "portColors": {"type": "object", "additionalProperties": {"$ref": "#/$defs/color"}},
        "keyStates": {"type": "object", "additionalProperties": {
          "type": "object", "additionalProperties": false, "required": ["tip"],
          "properties": {"theme": {"type": "string"}, "color": {"$ref": "#/$defs/color"}, "tip": {"type": "string"}}}},
        "backdropColors": {"type": "array", "items": {
          "type": "object", "additionalProperties": false, "required": ["label", "rgb"],
          "properties": {"label": {"type": "string"},
                         "rgb": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "integer", "minimum": 0, "maximum": 255}}}}},
        "plumbing": {"type": "array", "items": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "string"}}},
        "filePathFilters": {"type": "object", "additionalProperties": {"type": "string"}}
      },
      "additionalProperties": {"$ref": "#/$defs/container"}
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][A-Za-z0-9]*(\\.[a-z][A-Za-z0-9]*)*$"},
    "color": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"},
    "hosts": {"type": "array", "minItems": 1, "items": {"enum": ["maya", "blender", "app"]}},
    "conditions": {"type": "array", "items": {"type": "string", "pattern": "^!?[a-z][A-Za-z0-9.]*$"}},
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label"],
      "properties": {
        "label": {"type": "string", "minLength": 1},
        "tip": {"type": "string"},
        "tipDisabled": {"type": "string"},
        "shortcut": {"type": "string"},
        "shortcutPart": {"type": "integer", "minimum": 0},
        "icon": {"type": "string"},
        "checkable": {"type": "boolean"},
        "hosts": {"$ref": "#/$defs/hosts"},
        "needs": {"$ref": "#/$defs/conditions"},
        "enabled": {"$ref": "#/$defs/conditions"}
      }
    },
    "path": {"type": "string", "pattern": "^(menus|lists|graph|palette)(/[A-Za-z0-9.]+)+$"},
    "entry": {
      "anyOf": [
        {"const": "-"},
        {"$ref": "#/$defs/id"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id"],
          "properties": {
            "id": {"$ref": "#/$defs/id"}, "label": {"type": "string"}, "tip": {"type": "string"},
            "tipDisabled": {"type": "string"}, "glyph": {"type": "string"}, "hosts": {"$ref": "#/$defs/hosts"},
            "needs": {"$ref": "#/$defs/conditions"}, "enabled": {"$ref": "#/$defs/conditions"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "anyOf": [{"required": ["submenu"]}, {"required": ["ref"]}],
          "properties": {
            "submenu": {"type": "string"}, "id": {"type": "string"}, "tip": {"type": "string"}, "glyph": {"type": "string"},
            "ref": {"$ref": "#/$defs/path"}, "items": {"$ref": "#/$defs/entries"},
            "hosts": {"$ref": "#/$defs/hosts"}, "needs": {"$ref": "#/$defs/conditions"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["generator"],
          "properties": {
            "generator": {"type": "string"}, "action": {"$ref": "#/$defs/id"}, "choices": {"type": "string"},
            "labelField": {"type": "string"}, "tip": {"type": "string"},
            "hosts": {"$ref": "#/$defs/hosts"}, "needs": {"$ref": "#/$defs/conditions"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["include"],
          "properties": {"include": {"$ref": "#/$defs/path"}, "hosts": {"$ref": "#/$defs/hosts"}, "needs": {"$ref": "#/$defs/conditions"}}
        }
      ]
    },
    "entries": {"type": "array", "items": {"$ref": "#/$defs/entry"}},
    "container": {
      "anyOf": [
        {"$ref": "#/$defs/entries"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["items"],
          "properties": {"label": {"type": "string"}, "tip": {"type": "string"}, "items": {"$ref": "#/$defs/entries"}}
        }
      ]
    }
  }
}
